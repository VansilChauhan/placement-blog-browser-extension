{
  "manifest_version": 3,
  "name": "placement-blog",
  "version": "1.7",
  "description": "Auto-login to the placement blog, comfortable reading, and desktop alerts for new posts.",
  "action": {
    "default_title": "Open placement blog (auto login)"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "*://campus.placements.iitb.ac.in/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "*://campus.placements.iitb.ac.in/blog/*"
      ],
      "js": [
        "reader.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "*://campus.placements.iitb.ac.in/*"
      ],
      "exclude_matches": [
        "*://campus.placements.iitb.ac.in/blog/*"
      ],
      "js": [
        "jobs-dark.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "*://campus.placements.iitb.ac.in/*"
      ],
      "exclude_matches": [
        "*://campus.placements.iitb.ac.in/blog/*"
      ],
      "js": [
        "job-summary.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "permissions": [
    "alarms",
    "notifications",
    "storage",
    "offscreen",
    "background"
  ],
  "host_permissions": [
    "*://campus.placements.iitb.ac.in/*"
  ],
  "icons": {
    "128": "icon.png"
  }
}
